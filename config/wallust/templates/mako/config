# Global configuration
font= monospace 12
width=360
height=120

default-timeout=2500
max-history=10
sort=-time
layer=overlay

# Colors
background-color={{background}}{{alpha | alpha_hexa}}
text-color={{foreground}}
border-color={{color4}}
progress-color= source {{color2}}{{alpha | alpha_hexa}}

# Border
border-size=4
border-radius=0
padding=8
margin=8

# Urgency
[urgency=low]
border-color={{color4}}

[urgency=normal]
border-color={{color2}}

[urgency=high]
border-color={{color13}}
text-color={{color13}}
