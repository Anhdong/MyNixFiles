/* Rofi app launcher: square, wallust colors, JetBrains Mono */

configuration {
    modi:               "drun";
    font:               "JetBrains Mono Medium 12";
    show-icons:         true;
    display-drun:       "Apps";
    drun-display-format: "{name}";
    hover-select:       true;
    me-select-entry:    "MouseSecondary";
    me-accept-entry:    "MousePrimary";
    dpi:                1;
}

/* ---- Colors (generated by wallust from colors.rasi) ---- */
@theme "~/.config/rofi/colors.rasi"

/* ---- Aliases for the palette ---- */
* {
    background-alt:     @selected-active-background;
    selected:           @selected-urgent-background;
    active:             @selected-normal-background;
    urgent:             @selected;

    text-selected:      @background;
    text-color:         @foreground;
    border-color:       @selected;
}

/* ---- Layout ---- */
window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    width:              32%;
    border:             4px;
    border-radius:      0px;
    background-color:   @background;
}

mainbox {
    padding:            10px;
    orientation:        vertical;
    children:           [ "inputbar", "listbox" ];
    background-color:   transparent;
}

inputbar {
    padding:            10px;
    margin:             10px;
    children:           [ "entry" ];
    background-color:   transparent;
}

entry {
    expand:             false;
    width:              100%;
    padding:            10px;
    border-radius:      0px;
    background-color:   @selected;
    text-color:         @text-selected;
    cursor:             text;
    placeholder:        "Search...";
    placeholder-color:  inherit;
}

listbox {
    spacing:            20px;
    padding:            20px;
    orientation:        vertical;
    children:           [ "message", "listview" ];
    background-color:   transparent;
}

listview {
    columns:            1;
    lines:              6;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    spacing:            10px;
    border:             0px;
    background-color:   transparent;
}

/* ---- Entries ---- */
element {
    spacing:            10px;
    padding:            10px;
    border-radius:      0px;
    background-color:   transparent;
    text-color:         inherit;
    cursor:             pointer;
}

element normal.urgent {
    background-color:   @urgent;
    text-color:         @foreground;
}

element normal.active {
    background-color:   @active;
    text-color:         @foreground;
}

element selected.normal {
    background-color:   @selected;
    text-color:         @text-selected;
}

element selected.urgent,
element selected.active {
    background-color:   @urgent;
    text-color:         @text-selected;
}

element-icon {
    size:               48px;
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
}

element-text {
    vertical-align:     0.5;
    horizontal-align:   0.0;
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
}

/* ---- Messages and errors ---- */
message {
    border:             0px;
    background-color:   transparent;
}

textbox,
error-message {
    padding:            12px;
    border-radius:      0px;
    background-color:   @background-alt;
    text-color:         @background;
}

textbox {
    vertical-align:     0.5;
    horizontal-align:   0.0;
}

