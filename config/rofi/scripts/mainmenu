#!/usr/bin/env bash

rofi_dir="$HOME/.config/rofi"
scripts="$rofi_dir/scripts"

# Run a command once this rofi window has closed.
# (Starting a second rofi while this one is still open would clash.)
launch() {
    (
        for _ in {1..100}; do                      # give up after ~5 seconds
            pgrep -x rofi >/dev/null || break
            sleep 0.05
        done
        exec "$@"
    ) >/dev/null 2>&1 </dev/null &
}

if [ -z "$1" ]; then
    # First call: print the menu
    printf '\0prompt\x1fMenu\n'
    printf '\0no-custom\x1ftrue\n'
    printf '%s\n' \
        " Apps" \
        "󰸉 Wallpaper" \
        "󰖩 Wifi" \
        "󰂯 Bluetooth" \
        " Audio" \
        " Color Picker"
else
    # Second call: $1 is the picked entry
    case "$1" in
        ""*) launch rofi -show drun;;
        "󰸉"*) launch rofi -show wallpaper -config "$rofi_dir/config-wallpaper.rasi";;
        "󰖩"*) launch foot --app-id menu impala ;;
        "󰂯"*) launch foot --app-id menu bluetui ;;
        ""*) launch foot --app-id menu pulsemixer ;;
        " "*) launch hyprpicker -aq ;;
    esac
fi
