# Global configuration
font= monospace 16
width=320
height=120

default-timeout=2500
max-history=10
sort=-time
layer=overlay

# Colors
background-color=#050300D9
text-color=#E4DEC4
border-color=#858379
progress-color= source #7A5F4ED9

# Border
border-size=2
border-radius=4
padding=10
margin=10

# Urgency
[urgency=low]
border-color=#858379

[urgency=normal]
border-color=#7A5F4E

[urgency=high]
border-color=#909078
text-color=#909078
