#!/usr/bin/env bash

# Set directories
WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
TARGET_FILE="$HOME/.config/background"
ICON=""

# Ensure target directory exists
mkdir -p "$(dirname "$TARGET_FILE")"

# Select wallpaper using fsel (showing icon + base filename only, stripping the extension)
SELECTED=$(find "$WALLPAPER_DIR" -maxdepth 2 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) -exec basename {} \; | sort -u | sed "s/\.[^.]*$//; s/^/$ICON /" | fsel --dmenu)

# Exit if no file was selected
[ -z "$SELECTED" ] && exit 0

# Strip icon prefix to isolate the base filename
FILENAME="${SELECTED#* }"

# Resolve full path of the selected file (appending .* to match the original extension)
FULL_PATH=$(find "$WALLPAPER_DIR" -maxdepth 2 -type f -name "${FILENAME}.*" -print -quit)

# Copy and run post-selection hooks
if [ -n "$FULL_PATH" ]; then
    cp "$FULL_PATH" "$TARGET_FILE"

    # Restart swaybg
    systemctl --user restart swaybg
    systemctl --user restart mangobar

    # Run wallust
    wallust run "$TARGET_FILE"
fi

