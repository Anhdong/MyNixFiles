#!/usr/bin/env bash
FILE=~/.cache/wallust/poke.txt

[ -s "$FILE" ] || { echo "Missing or empty $FILE" >&2; exit 1; }
HEX=$(tr -d '#[:space:]' < "$FILE")

# Map the wallust color to the nearest PokéAPI color category
name=$(python3 - "$HEX" <<'EOF'
import sys, colorsys
h = sys.argv[1]
r, g, b = [int(h[i:i+2], 16) / 255 for i in (0, 2, 4)]
H, S, V = colorsys.rgb_to_hsv(r, g, b)
H *= 360
if V < 0.2:              n = "black"
elif S < 0.15:           n = "white" if V > 0.8 else "gray"
elif H < 15 or H >= 345: n = "red"
elif H < 40:             n = "brown" if V < 0.65 else "red"
elif H < 70:             n = "yellow"
elif H < 170:            n = "green"
elif H < 260:            n = "blue"
elif H < 300:            n = "purple"
else:                    n = "pink"
print(n)
EOF
)

# Cache the list of Pokémon for that color
LIST=~/.cache/poke-color-$name.txt
if [ ! -s "$LIST" ]; then
  curl -s "https://pokeapi.co/api/v2/pokemon-color/$name" \
    | jq -r '.pokemon_species[].name' > "$LIST"
fi

# Try random Pokémon of that color until pokemon-colorscripts accepts one
OUT=~/.cache/ff-poke-logo.txt
: > "$OUT"
for p in $(shuf -n 25 "$LIST"); do
  if pokemon-colorscripts -n "$p" --no-title > "$OUT" 2>/dev/null && [ -s "$OUT" ]; then
    break
  fi
done

# Last resort: any random Pokémon
[ -s "$OUT" ] || pokemon-colorscripts -r --no-title > "$OUT"

fastfetch --file-raw "$OUT"
