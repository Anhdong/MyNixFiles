// mangobar config (JSONC).
{
    "layer": "top",
    "height": 16,
    "buffer-scale": 1,
    // "scroll-interval": 100,
    // "smooth-scrolling-threshold": 5.0,

    "modules-left": [
	"custom/power",
        "workspaces"
    ],
    "modules-center": [
	"clock"
    ],
    "modules-right": [
	"battery"
    ],

    "workspaces": {
        "hide-empty": true,
        "pinned": [1, 2, 3, 4],
        "tag-names": ["一","二","三","四","五","六","七","八","九"],
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle",
	"scroll-interval": 100,
	"on-scroll-up": "mmsg dispatch viewtoright",
	"on-scroll-down": "mmsg dispatch viewtoleft"
    },
    "layout": {
        "format": "{}"
    },
    "window": {
        "format": "{}"
    },

    "cpu": {
        "format": " {load}%"
    },
    "memory": {
        "format": " {}%"
    },

    "battery": {
        "format": "{icon} {percent}% {ac}",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        // "icon-charging": "󰂄",
        // "icon-full": "󰁹",
        //"icon-ac": """
        "hide-on-ac": true
    },
    "clock": {
      "locale": "en_US.UTF-8",
      "format": "%H:%M %b %d",
      "format-alt": "ㅇㅅㅇ"
    },

        "custom/power": {
        "format": "",
        "on-click": "rofi -show mainmenu -config ~/.config/rofi/config-mainmenu.rasi "
    }
}
